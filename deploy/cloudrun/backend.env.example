ENV=production
PORT=8080
STORAGE_BACKEND=postgres

# PostgreSQL (Cloud SQL private IP example)
DB_HOST=172.27.160.5
DB_PORT=5432
DB_USER=postgres
DB_NAME=cyber_databrew_dev
# Prefer Secret Manager via backend-dev.sh: DB_PASSWORD_SECRET=...
DB_PASSWORD=replace-me

# Search / lakehouse optional dependencies
ELASTICSEARCH_URL=http://10.2.0.10:9200
# For lakehouse endpoints on Cloud Run, configure BigQuery project and dataset.
LAKEHOUSE_BACKEND=bigquery
LAKEHOUSE_BQ_PROJECT=
LAKEHOUSE_BQ_CATALOG=iceberg
LAKEHOUSE_BQ_DATASET=lakehouse_bronze

# Auth and messaging
DATABREW_TOKEN=dev-token
PUBSUB_PROJECT=green-valley-442103
TOPIC_MCAP_FINALIZED=gcs.mcap.finalized.v1
TOPIC_ASSET_EVENTS=cyber-databrew-asset-events
OUTBOX_TRANSPORT=internal
# When OUTBOX_TRANSPORT=pubsub and auto-sync is desired:
# OUTBOX_RELAY_ENABLED=true
# OUTBOX_ES_SUBSCRIBER_ENABLED=true
# OUTBOX_ES_SUBSCRIPTION=cyber-databrew-asset-events-search-sub
# OUTBOX_RELAY_LEASE_SEC=30
# OUTBOX_PROGRESS_LOG_INTERVAL_SEC=60
# When OUTBOX_TRANSPORT=kafka:
# OUTBOX_KAFKA_BROKERS=kafka-1:9092,kafka-2:9092
# OUTBOX_KAFKA_TOPIC=cyber-databrew-asset-events
# OUTBOX_KAFKA_GROUP_ID=cyber-databrew-outbox-es

# Runtime tuning
LOG_LEVEL=info
LOG_FORMAT=json
CB_ENABLED=false
# Rate limit disabled by default for dev (collector / seed jobs can burst).
# Set RATE_LIMIT_RPS>0 to enable per-IP token bucket; burst defaults to RPS*2.
RATE_LIMIT_RPS=0
# Pod Pending threshold: if a pod is Pending longer than this, mark it as Error (default: 15m).
# Increase if your cluster often has resource contention that recovers over time.
PIPELINE_UNSCHEDULABLE_PENDING_THRESHOLD=1h
