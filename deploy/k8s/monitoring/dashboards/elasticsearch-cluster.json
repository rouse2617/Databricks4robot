      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "editorMode": "code", "expr": "avg(elasticsearch_process_cpu_percent)", "legendFormat": "cpu_percent", "refId": "A" },
        { "editorMode": "code", "expr": "avg(elasticsearch_os_mem_used_percent)", "legendFormat": "mem_used_percent", "refId": "B" },
        { "editorMode": "code", "expr": "avg(elasticsearch_filesystem_data_used_percent)", "legendFormat": "disk_used_percent", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Thread Pool Queue / Rejected",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "editorMode": "code", "expr": "sum by (type) (elasticsearch_thread_pool_queue_count{type=~\"write|search\"})", "legendFormat": "queue_{{type}}", "refId": "A" },
        { "editorMode": "code", "expr": "sum by (type) (rate(elasticsearch_thread_pool_rejected_count{type=~\"write|search\"}[5m]))", "legendFormat": "rejected_{{type}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

