      "id": 14,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "editorMode": "code", "expr": "sum(rate(elasticsearch_indices_search_query_time_seconds[1m])) / clamp_min(sum(rate(elasticsearch_indices_search_query_total[1m])), 1)", "legendFormat": "query_rt_s", "refId": "A" },
        { "editorMode": "code", "expr": "sum(rate(elasticsearch_indices_search_fetch_time_seconds[1m])) / clamp_min(sum(rate(elasticsearch_indices_search_fetch_total[1m])), 1)", "legendFormat": "fetch_rt_s", "refId": "B" }
