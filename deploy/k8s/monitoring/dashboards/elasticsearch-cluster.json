        { "editorMode": "code", "expr": "sum(rate(elasticsearch_indices_search_query_total[1m]))", "legendFormat": "query_qps", "refId": "A" },
        { "editorMode": "code", "expr": "sum(elasticsearch_indices_search_query_current)", "legendFormat": "query_current", "refId": "B" }
