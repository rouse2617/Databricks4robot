  "panels": [
    { "type": "row", "title": "Cluster Health", "id": 1, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "type": "stat",
      "title": "Cluster Green",
      "id": 2,
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "editorMode": "code", "expr": "max(elasticsearch_cluster_health_status{color=\"green\"})", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "textMode": "value" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "NOT GREEN", "color": "red" }, "1": { "text": "GREEN", "color": "green" } } }] }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Data Nodes",
      "id": 3,
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "editorMode": "code", "expr": "max(elasticsearch_cluster_health_number_of_data_nodes)", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "textMode": "value" },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Shards State",
      "id": 4,
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "editorMode": "code", "expr": "max(elasticsearch_cluster_health_active_shards)", "legendFormat": "active", "refId": "A" },
        { "editorMode": "code", "expr": "max(elasticsearch_cluster_health_relocating_shards)", "legendFormat": "relocating", "refId": "B" },
        { "editorMode": "code", "expr": "max(elasticsearch_cluster_health_initializing_shards)", "legendFormat": "initializing", "refId": "C" },
        { "editorMode": "code", "expr": "max(elasticsearch_cluster_health_unassigned_shards)", "legendFormat": "unassigned", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
