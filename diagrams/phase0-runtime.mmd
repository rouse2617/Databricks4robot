%%{init: {'theme':'neutral'}}%%
%% Phase 0 运行态架构图(详见 docs/08-roadmap.md)
%% 关键简化:Cloud SQL Postgres 代替 Bigtable;只发 MCL,无 MCE;CDC 由 asset-service Outbox relay 承担
flowchart TB
    subgraph UI["Web UI (React + TS, 最小版)"]
      U1[搜索 / 详情]
      U2[QA 工作台 + Foxglove 嵌入]
    end

    BFF["data4cyber-api (BFF,Phase 0 REST+JSON)"]
    SDK["grace-sdk (Python)"]
    CLI["CLI"]

    subgraph Services["后端(Phase 0 最小集)"]
      AS["asset-service (Go)<br/>唯一写入者 · Outbox relay"]
      GW["mcap-gateway (Go)<br/>Streaming / Summary 提取"]
    end

    subgraph Stores["存储(Phase 0)"]
      PG["Cloud SQL Postgres ⭐<br/>assets 表(8 个 JSONB 伪列族)<br/>asset_events 表(cf:event 独立)<br/>idempotency_keys / outbox"]
      GCS["GCS<br/>grace-raw-mcap / derived"]
      OS["OpenSearch on GKE<br/>(Phase 0 可选 / 或先不上)"]
    end

    subgraph Events["事件与编排(Phase 0)"]
      MCL["Pub/Sub: grace-mcl<br/>唯一事件流"]
      DG["Dagster on GKE"]
      Ray["Ray on GKE"]
    end

    %% 入口
    U1 --> BFF
    U2 --> BFF
    BFF -->|REST / JSON| AS
    BFF --> GW
    SDK -->|gRPC| AS
    SDK --> GW
    CLI --> AS

    %% 权威写路径:同步写 PG + outbox relay 发 MCL
    AS -->|1. sync write| PG
    AS -->|2. outbox row| PG
    PG -.3. outbox relay.-> MCL
    GW --> GCS
    GW -->|read meta| PG

    %% 下游订阅
    MCL --> OS
    MCL --> DG

    %% 编排
    DG --> Ray
    Ray -->|API write| AS
    Ray --> GCS

    %% Foxglove
    U2 -.signed URL.-> GCS
    U2 -.外链.-> FX["Foxglove App"]

    classDef store fill:#E0F2FE,stroke:#0369A1
    classDef svc fill:#FEF3C7,stroke:#B45309
    classDef ui fill:#F0FDF4,stroke:#166534
    classDef evt fill:#FCE7F3,stroke:#BE185D
    classDef bff fill:#EDE9FE,stroke:#6D28D9

    class PG,GCS,OS store
    class AS,GW svc
    class U1,U2,SDK,CLI ui
    class MCL,DG,Ray,FX evt
    class BFF bff
