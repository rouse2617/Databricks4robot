%%{init: {'theme':'neutral'}}%%
%% 目标态(Phase 1+)架构图。Phase 0 运行态参见 phase0-runtime.mmd
flowchart TB
    subgraph UI["Web UI (React + TS)"]
      U1[搜索 / 详情 / Lineage<br/>自研]
      U2[QA 工作台 + Foxglove]
      U3[Dashboard]
    end

    BFF["data4cyber-api (BFF)<br/>浏览器唯一入口 · URN↔UUID 转换"]
    SDK["grace-sdk (Python)<br/>算法用户唯一入口"]
    CLI["CLI (Python)<br/>Ops 运维"]

    subgraph Services["后端微服务"]
      AS["asset-service (Go)<br/>唯一写入者 · CRUD / 状态机 / URN / Outbox"]
      GW["mcap-gateway (Go)<br/>Streaming / Range GET"]
      SS["search-service (Go/Py)"]
      CS["cluster-service (Go)"]
      TS["transfer-service (Go)"]
    end

    subgraph Stores["存储底座(目标态)"]
      BT["Cloud Bigtable ⭐<br/>9 列族宽表 / asset_id 主键<br/>cf:core/time/tag/file/qa/<br/>event/lineage/algo/emb"]
      GCS["GCS<br/>grace-raw-mcap / derived / annotation"]
      OS["OpenSearch<br/>Tag / 全文"]
      VS["Vertex AI Vector Search<br/>多模态 (Phase 2)"]
      BQ["BigQuery<br/>OLAP / 审计"]
    end

    subgraph Events["事件与编排"]
      MCE["Pub/Sub: grace-mce<br/>意图(Phase 1+)"]
      MCL["Pub/Sub: grace-mcl<br/>权威事实(Phase 0 起)"]
      DG["Dagster on GKE<br/>Asset graph + Sensor"]
      Ray["Ray on GKE (KubeRay)<br/>分布式算力"]
    end

    %% 入口边界(见 ADR-007)
    U1 --> BFF
    U2 --> BFF
    U3 --> BFF
    BFF -->|gRPC URN→UUID| AS
    BFF -->|HTTP| GW
    BFF --> SS

    SDK -->|gRPC| AS
    SDK -->|HTTP streaming| GW
    CLI --> AS

    %% Phase 1+ MCE 异步入口
    MCE -.Phase 1+ async ingest.-> AS

    %% 权威写入:asset-service → Bigtable → Outbox → MCL
    AS -->|writes| BT
    AS -->|Outbox relay<br/>at-least-once| MCL
    GW --> GCS
    GW -->|read meta| BT

    MCL -->|CDC Dataflow| OS
    MCL -->|CDC Dataflow| VS
    BT  -->|External Table / Streaming| BQ
    MCL -->|sensor| DG

    DG  -->|PipesRayJobClient| Ray
    Ray -->|materialize| DG
    Ray -->|API write via gRPC| AS
    Ray -->|R/W files| GCS

    SS  --> OS
    SS  --> VS
    SS  -->|回源 UUID→URN| AS

    U2  -.signed URL.-> GCS
    U2  -.外链.-> Foxglove["Foxglove App"]

    classDef store fill:#E0F2FE,stroke:#0369A1
    classDef svc fill:#FEF3C7,stroke:#B45309
    classDef ui fill:#F0FDF4,stroke:#166534
    classDef evt fill:#FCE7F3,stroke:#BE185D
    classDef bff fill:#EDE9FE,stroke:#6D28D9

    class BT,GCS,OS,VS,BQ store
    class AS,GW,SS,CS,TS svc
    class U1,U2,U3,SDK,CLI ui
    class MCE,MCL,DG,Ray,Foxglove evt
    class BFF bff
