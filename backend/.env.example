# ── Server ──────────────────────────────────────────────
ENV=development
PORT=8080
STORAGE_BACKEND=postgres   # bigtable | postgres

# ── Bigtable ─────────────────────────────────────────────
BIGTABLE_PROJECT=your-gcp-project
BIGTABLE_INSTANCE=poc-datainfra

# ── PostgreSQL (used when STORAGE_BACKEND=postgres) ──────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=data4cyber

# ── Trino / Iceberg analytical query layer ───────────────
TRINO_ENABLED=true
TRINO_URL=http://data-platform@localhost:8082
TRINO_CATALOG=iceberg
TRINO_SCHEMA=robot
LAKEHOUSE_REPORT_PATH=../deploy/local/iceberg/notebooks/lakehouse_report.json

# ── GCS ─────────────────────────────────────────────────
GCS_PROJECT=your-gcp-project
GCS_DERIVED_BUCKET=grace-derived-your-project

# ── Pub/Sub ──────────────────────────────────────────────
PUBSUB_PROJECT=your-gcp-project
TOPIC_MCAP_FINALIZED=gcs.mcap.finalized.v1
TOPIC_ASSET_EVENTS=grace-asset-events

# ── Auth (Phase 0 static token) ─────────────────────────
GRACE_TOKEN=dev-token-change-me

# ── Rate Limiting (per IP) ──────────────────────────────
# RATE_LIMIT_RPS=100        # requests per second per IP (0 = disabled)
# RATE_LIMIT_BURST=200      # burst size (default = RPS * 2)

# ── Circuit Breaker ─────────────────────────────────────
# CB_ENABLED=true           # enable circuit breaker
# CB_WINDOW_SEC=60          # sliding window in seconds
# CB_THRESHOLD=10           # error count to trip
# CB_COOLDOWN_SEC=30        # cooldown before half-open

# ── Logging ─────────────────────────────────────────────
# LOG_LEVEL=info            # debug, info, warn, error
# LOG_FORMAT=text           # text, json
# LOG_FILE=                 # file path (empty = stdout only)

# ── GCP credentials ─────────────────────────────────────
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# ── Local emulators (override when using docker-compose) ─
# BIGTABLE_EMULATOR_HOST=localhost:8086
# PUBSUB_EMULATOR_HOST=localhost:8085
