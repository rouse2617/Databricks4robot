# ── Server ──────────────────────────────────────────────
# Optional explicit env file path loaded at runtime before this process env.
# Example: BACKEND_ENV_FILE=deploy/cloudrun/backend.env
# BACKEND_ENV_FILE=
ENV=development
PORT=8080
# STORAGE_BACKEND: only `postgres` is supported.
STORAGE_BACKEND=postgres

# ── PostgreSQL (used when STORAGE_BACKEND=postgres) ──────
# Direct connection (local dev without PgBouncer):
DB_HOST=localhost
DB_PORT=5432
# Via PgBouncer (docker-compose / production):
# DB_HOST=pgbouncer
# DB_PORT=6432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cyber_databrew_dev

# ── Lakehouse analytical query layer (BigQuery) ───────────
# Lakehouse analytical query layer (BigQuery over BigLake-managed Iceberg).
# LAKEHOUSE_BACKEND: "bigquery" (default) or "none".
LAKEHOUSE_BACKEND=bigquery
LAKEHOUSE_BQ_PROJECT=
LAKEHOUSE_BQ_DATASET=lakehouse_bronze
# Host-relative path to the locally generated lakehouse MVP report.
# When running the backend inside a container, override to a path that exists
# in the container or mount the file in (e.g. /var/lakehouse/lakehouse_report.json).
LAKEHOUSE_REPORT_PATH=../deploy/local/iceberg/notebooks/lakehouse_report.json

# ── Elasticsearch search layer ───────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
# Optional HTTP Basic (e.g. GKE dev ES with xpack.security.enabled=true).
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=

# ── Outbox relay + ES subscriber transport ───────────────────────────────
# OUTBOX_TRANSPORT: internal | pubsub | kafka
# - internal: in-process channel (default, no external MQ dependency)
# - pubsub: requires PUBSUB_PROJECT/TOPIC_ASSET_EVENTS/OUTBOX_ES_SUBSCRIPTION
# - kafka: requires OUTBOX_KAFKA_BROKERS (+ optional topic/group)
# OUTBOX_TRANSPORT=internal
#
# Relay/subscriber toggles:
# OUTBOX_RELAY_ENABLED=false
# OUTBOX_RELAY_BATCH_SIZE=200
# OUTBOX_RELAY_INTERVAL_MS=500
# OUTBOX_RELAY_SAFETY_LAG_SEC=2
# OUTBOX_RELAY_LEASE_SEC=30
# OUTBOX_RELAY_MAX_RETRIES=20
# OUTBOX_PROGRESS_LOG_INTERVAL_SEC=60   # 0 disables periodic progress logs
# OUTBOX_RELAY_PARALLEL_KEYS=8          # concurrent ordering-key groups per flush (1 = fully serial)
# OUTBOX_ES_CHECKPOINT_SHARDS=16        # row count in es_sync_checkpoint; backs consumer_lag in /search/sync-progress (max 1024)
# OUTBOX_ES_CHECKPOINT_IDLE_AFTER_SEC=300  # idle-shard advance: treat checkpoint rows older than this as caught up to outbox_published_max_seq (0 disables)
#
# OUTBOX_INTERNAL_SUBSCRIBER_WORKERS (default 8): internal transport only.
# - Multiple goroutines consume the in-memory bus; routing uses payload asset_id / mcap key → FNV % workers.
# - Same asset_id always lands on the same worker queue → order preserved per asset.
# - Different assets may Build + ES bulk in parallel (each message is still a single-doc bulk).
# - Raise toward 16–32 for throughput until CPU or Elasticsearch saturates; set to 1 for legacy serial mode.
# OUTBOX_INTERNAL_SUBSCRIBER_WORKERS=8
#
# OUTBOX_INTERNAL_BUS_BUFFER (default 1024): internal transport only.
# - Channel buffer for the in-process bus connecting publisher → subscriber workers.
# - Increase when the relay flushes bursts larger than the subscriber can drain to avoid blocking publishes.
# OUTBOX_INTERNAL_BUS_BUFFER=1024
#
# OUTBOX_INTERNAL_SUBSCRIBER_BATCH_SIZE (default 1): internal transport only.
# - Maximum events coalesced into a single ES _bulk request per worker.
# - 1 disables batching (legacy: one BulkIndex HTTP call per event).
# - Recommend 50 in high-throughput steady state; per-asset ordering is preserved
#   because routing still pins each asset_id to one worker, and same-asset events
#   are deduped to a single Build call at the latest event_seq.
# OUTBOX_INTERNAL_SUBSCRIBER_BATCH_SIZE=50
#
# OUTBOX_INTERNAL_SUBSCRIBER_BATCH_WAIT_MS (default 0): internal transport only.
# - Max time a worker waits after the first message arrives before flushing a partial batch.
# - 0 means "drain whatever is already in the channel without waiting; flush as soon as the worker would block".
# - Recommend 25 to coalesce small spikes; raise carefully — directly adds to per-event indexing latency.
# OUTBOX_INTERNAL_SUBSCRIBER_BATCH_WAIT_MS=25
# OUTBOX_ES_SUBSCRIBER_ENABLED=false
#
# Pub/Sub mode: consumes TOPIC_ASSET_EVENTS via this subscription (short name in PUBSUB_PROJECT).
# OUTBOX_ES_SUBSCRIPTION=cyber-databrew-asset-events-search-sub
#
# Kafka mode:
# OUTBOX_KAFKA_BROKERS=localhost:9092
# OUTBOX_KAFKA_TOPIC=cyber-databrew-asset-events   # default: TOPIC_ASSET_EVENTS
# OUTBOX_KAFKA_GROUP_ID=cyber-databrew-outbox-es

# Admin API (X-Admin-Token, not DATABREW_TOKEN). Empty = admin routes disabled.
# ADMIN_TOKEN=

# ── GCS ─────────────────────────────────────────────────
GCS_PROJECT=your-gcp-project
GCS_DERIVED_BUCKET=grace-derived-your-project

# ── Pub/Sub ──────────────────────────────────────────────
PUBSUB_PROJECT=your-gcp-project
TOPIC_MCAP_FINALIZED=gcs.mcap.finalized.v1
TOPIC_ASSET_EVENTS=cyber-databrew-asset-events

# ── Auth (Phase 0 static token) ─────────────────────────
DATABREW_TOKEN=dev-token-change-me

# ── Rate Limiting (per IP) ──────────────────────────────
# RATE_LIMIT_RPS=100        # requests per second per IP (0 = disabled)
# RATE_LIMIT_BURST=200      # burst size (default = RPS * 2)

# ── Circuit Breaker ─────────────────────────────────────
# CB_ENABLED=true           # enable circuit breaker
# CB_WINDOW_SEC=60          # sliding window in seconds
# CB_THRESHOLD=10           # error count to trip
# CB_COOLDOWN_SEC=30        # cooldown before half-open

# ── Logging ─────────────────────────────────────────────
# LOG_LEVEL=info            # debug, info, warn, error
# LOG_FORMAT=text           # text, json
# LOG_FILE=                 # file path (empty = stdout only)

# ── GCP credentials ─────────────────────────────────────
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# ── Local emulators (override when using docker-compose) ─
# PUBSUB_EMULATOR_HOST=localhost:8085
