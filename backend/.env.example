# ── Server ──────────────────────────────────────────────
ENV=development
PORT=8080
# STORAGE_BACKEND: only `postgres` is supported.
# `bigtable` is DEPRECATED and the server will fail fast on startup.
STORAGE_BACKEND=postgres

# ── Bigtable (DEPRECATED — kept for historical reference only) ──
# BIGTABLE_PROJECT=your-gcp-project
# BIGTABLE_INSTANCE=poc-datainfra

# ── PostgreSQL (used when STORAGE_BACKEND=postgres) ──────
# Direct connection (local dev without PgBouncer):
DB_HOST=localhost
DB_PORT=5432
# Via PgBouncer (docker-compose / production):
# DB_HOST=pgbouncer
# DB_PORT=6432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=data4cyber

# ── Trino / Iceberg analytical query layer ───────────────
TRINO_ENABLED=true
TRINO_URL=http://data-platform@localhost:8082
TRINO_CATALOG=iceberg
TRINO_SCHEMA=robot
# Host-relative path to the locally generated lakehouse MVP report.
# When running the backend inside a container, override to a path that exists
# in the container or mount the file in (e.g. /var/lakehouse/lakehouse_report.json).
LAKEHOUSE_REPORT_PATH=../deploy/local/iceberg/notebooks/lakehouse_report.json

# ── Elasticsearch search layer ───────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ── CDC / WAL-driven sync (long-term architecture skeleton) ──
# Set to true to enable CDC/WAL-driven sync (requires a running Kafka/Redpanda + Debezium).
# CDC_ENABLED=false
# Transport adapter: debezium-kafka (Redpanda/Kafka via Debezium) or in-memory (local testing only).
# CDC_SOURCE_DRIVER=debezium-kafka
# Comma-separated Kafka/Redpanda broker addresses (host:port).
# CDC_KAFKA_BROKERS=localhost:19092
# Kafka consumer group ID for CDC consumers (must be unique per deployment).
# CDC_KAFKA_GROUP_ID=cyber-databrew-cdc
# Per-topic poll timeout in milliseconds (how long to wait for new messages before returning an empty batch).
# CDC_KAFKA_POLL_TIMEOUT_MS=1000
# Maximum number of events per poll batch (controls memory usage and processing latency).
# CDC_KAFKA_MAX_BATCH=100
# Per-table Kafka topic names consumed by the backend CDC adapter must match Debezium’s emitted topics.
# Code defaults below fit wiring where Kafka topics are the bare table names. Local Compose connectors under
# deploy/local/cdc use topic.prefix=data4cyber and PostgresConnector emits "{prefix}.{schema}.{table}",
# so wire like:
#   CDC_TOPIC_ASSET_EVENTS=data4cyber.public.asset_events
#   CDC_TOPIC_ASSETS=data4cyber.public.assets
#   CDC_TOPIC_ASSET_TAGS=data4cyber.public.asset_tags
#   CDC_TOPIC_ASSET_ALGO_LATEST=data4cyber.public.asset_algo_latest
#   CDC_TOPIC_MCAP_FILES=data4cyber.public.mcap_files
# Inside Docker network stacks use CDC_KAFKA_BROKERS=redpanda:9092; from host use localhost:19092.
# CDC_TOPIC_ASSET_EVENTS=asset_events
# CDC_TOPIC_ASSETS=assets
# CDC_TOPIC_ASSET_TAGS=asset_tags
# CDC_TOPIC_ASSET_ALGO_LATEST=asset_algo_latest
# CDC_TOPIC_MCAP_FILES=mcap_files
# Local directory for Bronze JSONL staging files (consumed by the Iceberg merge job).
# CDC_BRONZE_STAGING_DIR=/tmp/iceberg-staging

# Admin API (X-Admin-Token, not GRACE_TOKEN). Empty = admin routes disabled.
# ADMIN_TOKEN=

# ── GCS ─────────────────────────────────────────────────
GCS_PROJECT=your-gcp-project
GCS_DERIVED_BUCKET=grace-derived-your-project

# ── Pub/Sub ──────────────────────────────────────────────
PUBSUB_PROJECT=your-gcp-project
TOPIC_MCAP_FINALIZED=gcs.mcap.finalized.v1
TOPIC_ASSET_EVENTS=grace-asset-events

# ── Auth (Phase 0 static token) ─────────────────────────
GRACE_TOKEN=dev-token-change-me

# ── Rate Limiting (per IP) ──────────────────────────────
# RATE_LIMIT_RPS=100        # requests per second per IP (0 = disabled)
# RATE_LIMIT_BURST=200      # burst size (default = RPS * 2)

# ── Circuit Breaker ─────────────────────────────────────
# CB_ENABLED=true           # enable circuit breaker
# CB_WINDOW_SEC=60          # sliding window in seconds
# CB_THRESHOLD=10           # error count to trip
# CB_COOLDOWN_SEC=30        # cooldown before half-open

# ── Logging ─────────────────────────────────────────────
# LOG_LEVEL=info            # debug, info, warn, error
# LOG_FORMAT=text           # text, json
# LOG_FILE=                 # file path (empty = stdout only)

# ── GCP credentials ─────────────────────────────────────
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# ── Local emulators (override when using docker-compose) ─
# BIGTABLE_EMULATOR_HOST=localhost:8086
# PUBSUB_EMULATOR_HOST=localhost:8085
