{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://data-platform/schemas/events/asset_updated.v1.json",
  "title": "asset_updated.v1",
  "description": "Emitted when mutable asset fields are updated. Written in the same transaction as the assets update.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "asset_id",
    "lifecycle_state",
    "owner",
    "reviewer"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^[0-9A-Za-z]{8}$",
      "description": "Asset identifier (8-char alphanumeric)."
    },
    "lifecycle_state": {
      "type": "string",
      "description": "Lifecycle state after update."
    },
    "owner": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    }
  }
}
