{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://data-platform/schemas/events/algo_unblocked.v1.json",
  "title": "algo_unblocked.v1",
  "description": "Emitted when a blocked downstream algorithm becomes pending after dependencies are satisfied.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "algo_key",
    "algo_name",
    "algo_version",
    "prev_status",
    "new_status"
  ],
  "properties": {
    "algo_key": {
      "type": "string",
      "description": "Versioned algorithm key (<name>@<version>)."
    },
    "algo_name": {
      "type": "string"
    },
    "algo_version": {
      "type": "string"
    },
    "prev_status": {
      "type": "string",
      "enum": ["blocked"]
    },
    "new_status": {
      "type": "string",
      "enum": ["pending"]
    }
  }
}
