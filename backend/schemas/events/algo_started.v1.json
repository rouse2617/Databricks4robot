{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://data-platform/schemas/events/algo_started.v1.json",
  "title": "algo_started.v1",
  "description": "Emitted when an algorithm transitions to running for an asset.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "algo_key",
    "algo_name",
    "algo_version",
    "prev_status",
    "new_status"
  ],
  "properties": {
    "algo_key": {
      "type": "string",
      "description": "Versioned algorithm key (<name>@<version>)."
    },
    "algo_name": {
      "type": "string"
    },
    "algo_version": {
      "type": "string"
    },
    "prev_status": {
      "type": "string",
      "enum": ["", "pending"]
    },
    "new_status": {
      "type": "string",
      "enum": ["running"]
    },
    "run_id": {
      "type": "string",
      "description": "Optional runner-provided run identifier."
    }
  }
}
