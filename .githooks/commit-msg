#!/usr/bin/env bash
set -euo pipefail

MSG_FILE="${1:-}"
if [[ -z "${MSG_FILE}" || ! -f "${MSG_FILE}" ]]; then
  echo "commit-msg hook error: missing commit message file" >&2
  exit 1
fi

FIRST_LINE="$(sed -n '1p' "${MSG_FILE}" | tr -d '\r')"

# Allow merge/revert/fixup/squash commits generated by git tooling.
if [[ "${FIRST_LINE}" =~ ^(Merge|Revert|fixup!|squash!) ]]; then
  exit 0
fi

PATTERN='^(feat|fix|docs|refactor|test|chore)(\([a-z0-9._/-]+\))?(!)?: [^[:space:]].+$'
if [[ "${FIRST_LINE}" =~ ${PATTERN} ]]; then
  exit 0
fi

cat >&2 <<'EOF'
ERROR: Commit message must follow Conventional Commits.

Required format:
  <type>[optional scope]: <description>

Allowed types:
  feat, fix, docs, refactor, test, chore

Examples:
  feat(backend): add delivery retry endpoint
  fix(frontend): prevent duplicate request on refresh
  docs(api): document pagination token behavior

Breaking change examples:
  feat(api)!: remove legacy endpoint
  feat(api): remove legacy endpoint

  BREAKING CHANGE: clients must migrate to /v2 endpoint
EOF

exit 1
