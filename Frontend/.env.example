VITE_API_BASE_URL=http://localhost:8080
# Preview backend Pod id (set by scripts/dev-local.sh / npm run dev:preview).
# VITE_PREVIEW_ID=b723ff083383
# VITE_PREVIEW_HOST=https://cyber-databrew-dev.cyberorigin.ai
# Dev-only helper: when set, frontend auto-login uses this token
# and Login page pre-fills the token input.
VITE_DEV_ACCESS_TOKEN=
# Base URL for the standalone mcap-preview service used by the
# asset live-stream player. Leave empty to use same-origin (the
# frontend gateway/proxy should route /api/v1/preview/* to mcap-preview).
# Set to e.g. http://localhost:8090 when running services/mcap-preview
# locally against a port-forwarded backend.
VITE_MCAP_PREVIEW_BASE_URL=
