{
	"name": "cyber-databrew-frontend",
	"private": true,
	"version": "0.1.1",
	"type": "module",
	"scripts": {
		"dev": "vite --host",
		"dev:shared": "bash ../scripts/dev-local.sh --shared",
		"dev:preview": "bash ../scripts/dev-local.sh --preview",
		"dev:remote": "VITE_API_BASE_URL=https://cyber-databrew-backend-dev-wtttm6suaq-uc.a.run.app vite --host",
		"build": "vite build",
		"typecheck": "tsc -b",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"preview": "vite preview",
		"lint": "biome check src",
		"omm:setup": "PATH=\"/Applications/Cursor.app/Contents/Resources/app/bin:$PATH\" npm exec --yes -- omm setup cursor",
		"omm:view": "npm exec --yes -- omm view",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install --with-deps chromium"
	},
	"dependencies": {
		"@ant-design/icons": "^6.3.2",
		"@ant-design/v5-patch-for-react-19": "^1.0.3",
		"@mcap/core": "^2.2.1",
		"@monaco-editor/react": "^4.7.0",
		"@xyflow/react": "^12.10.2",
		"ansi-to-react": "^6.2.6",
		"antd": "^5.20.7",
		"axios": "^1.10.0",
		"dagre": "^0.8.5",
		"dayjs": "^1.11.13",
		"echarts": "^5.6.0",
		"echarts-for-react": "^3.0.2",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-router-dom": "^7.6.2",
		"react-virtualized-auto-sizer": "^2.0.3",
		"react-window": "^2.2.7",
		"three": "^0.185.0",
		"uplot": "^1.6.32"
	},
	"devDependencies": {
		"@biomejs/biome": "~2.4.14",
		"@fast-check/vitest": "^0.4.0",
		"@playwright/test": "^1.52.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/dagre": "^0.7.54",
		"@types/node": "^24.0.3",
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.1.2",
		"@types/three": "^0.185.0",
		"@vitejs/plugin-react": "^4.4.1",
		"@vitest/coverage-v8": "^4.1.5",
		"autoprefixer": "^10.4.19",
		"fast-check": "^4.7.0",
		"jsdom": "^29.0.2",
		"oh-my-mermaid": "^0.2.0",
		"postcss": "^8.4.38",
		"tailwindcss": "^3.4.3",
		"typescript": "~5.8.3",
		"vite": "^6.3.5",
		"vitest": "^4.1.5"
	}
}
